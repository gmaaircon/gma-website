---
layout: base.njk
---
<section class="page-hero">
  <div class="container">
    <span class="eyebrow"><a href="/blog/" style="color:inherit;text-decoration:none">Blog</a> · <time datetime="{{ page.date | isoDate }}">{{ page.date | ukDate }}</time></span>
    <h1>{{ title }}</h1>
    {% if summary %}<p>{{ summary }}</p>{% endif %}
  </div>
</section>
<article class="section">
  <div class="container prose">
    {% if image %}<img src="{{ image }}" alt="" style="border-radius:14px;margin-bottom:2rem">{% endif %}
    {{ content | safe }}
    <p style="margin-top:2.5rem"><a class="btn btn--outline" href="/blog/">{% icon "arrow" %} Back to all posts</a></p>
  </div>
</article>
