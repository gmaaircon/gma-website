<!doctype html>
<html lang="en-GB">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title }}</title>
  <meta name="description" content="{{ description }}">
  {%- set canonical = site.url + page.url %}
  {% if noindex %}<meta name="robots" content="noindex">{% endif %}
  <link rel="canonical" href="{{ canonical }}">
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="{{ site.name }}">
  <meta property="og:title" content="{{ title }}">
  <meta property="og:description" content="{{ description }}">
  <meta property="og:url" content="{{ canonical }}">
  <meta property="og:image" content="{{ site.url }}/assets/img/og-image.jpg">
  <meta property="og:locale" content="en_GB">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="theme-color" content="#0098C3">
  <link rel="icon" href="/favicon.ico" sizes="any">
  <link rel="icon" href="/assets/img/brand/gma-logo-icon.svg" type="image/svg+xml">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Mulish:wght@400;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/assets/css/site.css">
  {% if heroImage %}<link rel="preload" as="image" href="{{ heroImage }}">{% endif %}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "HVACBusiness",
        "@id": "{{ site.url }}/#business",
        "name": "{{ site.legalName }}",
        "url": "{{ site.url }}/",
        "logo": "{{ site.url }}/assets/img/brand/gma-logo-full.svg",
        "image": "{{ site.url }}/assets/img/og-image.jpg",
        "telephone": "{{ site.phoneLink }}",
        "email": "{{ site.email }}",
        "address": { "@type": "PostalAddress", "addressRegion": "Scotland", "addressCountry": "GB" },
        "areaServed": [{ "@type": "Place", "name": "Scotland" }, { "@type": "Place", "name": "North of England" }],
        "openingHours": "Mo-Fr 09:00-17:00",
        "sameAs": ["{{ site.social.facebook }}", "{{ site.social.instagram }}", "{{ site.social.linkedin }}"]
      },
      { "@type": "WebSite", "@id": "{{ site.url }}/#website", "url": "{{ site.url }}/", "name": "{{ site.name }}", "inLanguage": "en-GB", "publisher": { "@id": "{{ site.url }}/#business" } },
      { "@type": "WebPage", "url": "{{ canonical }}", "name": "{{ title }}", "description": "{{ description }}", "isPartOf": { "@id": "{{ site.url }}/#website" }, "inLanguage": "en-GB" }
      {%- if page.url != "/" %},
      { "@type": "BreadcrumbList", "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "{{ site.url }}/" },
        { "@type": "ListItem", "position": 2, "name": "{{ crumb or title }}", "item": "{{ canonical }}" }
      ] }
      {%- endif %}
      {%- if schemaExtra %},{{ schemaExtra | safe }}{% endif %}
      {%- if page.url == "/tm44-inspections/" %},{ "@type": "FAQPage", "mainEntity": [{% for f in tm44.faq %}{ "@type": "Question", "name": {{ f.q | json | safe }}, "acceptedAnswer": { "@type": "Answer", "text": {{ f.a | json | safe }} } }{% if not loop.last %},{% endif %}{% endfor %}] },{ "@type": "Service", "name": "TM44 air conditioning inspections", "serviceType": "Air conditioning energy inspection (CIBSE TM44)", "provider": { "@id": "https://gma-ac.com/#business" }, "areaServed": ["Scotland", "North of England"] }{% endif %}
    ]
  }
  </script>
</head>
<body class="{{ bodyClass }}">
  <a class="skip" href="#main">Skip to content</a>
  <div class="topbar">
    <div class="container topbar__inner">
      <span class="topbar__tag">{{ site.tagline }}</span>
      <span class="topbar__links">
        <span>{% icon "pin" %} {{ site.baseLocation }}</span>
        <a href="tel:{{ site.phoneLink }}">{% icon "phone" %} {{ site.phoneDisplay }}</a>
        <a href="mailto:{{ site.email }}">{% icon "mail" %} {{ site.email }}</a>
      </span>
    </div>
  </div>
  <header class="header" id="top">
    <div class="container header__inner">
      <a class="logo" href="/" aria-label="GMA Air Conditioning – home">
        <img src="/assets/img/brand/gma-logo-full.svg" alt="GMA Air Conditioning" width="180" height="64">
      </a>
      <button class="nav-toggle" aria-expanded="false" aria-controls="nav" aria-label="Menu"><span></span><span></span><span></span></button>
      <nav class="nav" id="nav" aria-label="Main">
        <ul>
          {%- for item in nav %}
          <li><a href="{{ item.url }}"{% if page.url == item.url or (item.url != "/" and page.url.startsWith(item.url)) %} aria-current="page"{% endif %}>{{ item.label }}</a></li>
          {%- endfor %}
        </ul>
        <a class="btn btn--primary nav__cta" href="tel:{{ site.phoneLink }}">{% icon "phone" %} Call us</a>
      </nav>
    </div>
  </header>

  <main id="main">
    {{ content | safe }}
  </main>

  <section class="cta-band">
    <div class="container cta-band__inner">
      <div>
        <h2>{{ home.ctaTitle }}</h2>
        <p>{{ home.ctaText }}</p>
      </div>
      <div class="cta-band__actions">
        <a class="btn btn--light" href="/contact/">Get a free quote {% icon "arrow" %}</a>
        <a class="btn btn--outline-light" href="tel:{{ site.phoneLink }}">{% icon "phone" %} {{ site.phoneDisplay }}</a>
      </div>
    </div>
  </section>

  <footer class="footer">
    <div class="container footer__grid">
      <div>
        <img class="footer__logo" src="/assets/img/brand/gma-logo-full.svg" alt="GMA Air Conditioning" width="170" height="60">
        <p>{{ site.footerBlurb }}</p>
        <div class="social">
          <a href="{{ site.social.facebook }}" rel="noopener" target="_blank" aria-label="Facebook"><svg viewBox="0 0 24 24" class="icon" fill="currentColor"><path d="M14 8h3V4h-3a4 4 0 0 0-4 4v2H8v4h2v8h4v-8h3l1-4h-4V8z"/></svg></a>
          <a href="{{ site.social.instagram }}" rel="noopener" target="_blank" aria-label="Instagram"><svg viewBox="0 0 24 24" class="icon" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor"/></svg></a>
          <a href="{{ site.social.linkedin }}" rel="noopener" target="_blank" aria-label="LinkedIn"><svg viewBox="0 0 24 24" class="icon" fill="currentColor"><path d="M4 9h4v12H4zM6 3a2 2 0 1 1 0 4 2 2 0 0 1 0-4zM10 9h4v1.7c.6-1 2-2 4-2 3.5 0 4 2.3 4 5.3v7h-4v-6c0-1.5 0-3.4-2-3.4s-2.3 1.6-2.3 3.3V21H10z"/></svg></a>
        </div>
      </div>
      <div>
        <h3>Quick links</h3>
        <ul>{% for item in nav %}<li><a href="{{ item.url }}">{{ item.label }}</a></li>{% endfor %}</ul>
      </div>
      <div>
        <h3>Services</h3>
        <ul>
          {%- for s in services.items %}{% if loop.index <= 7 %}<li><a href="{{ s.link or '/services/' }}">{{ s.title }}</a></li>{% endif %}{% endfor %}
        </ul>
      </div>
      <div>
        <h3>Contact us</h3>
        <ul class="footer__contact">
          <li>{% icon "phone" %} <a href="tel:{{ site.phoneLink }}">{{ site.phoneDisplay }}</a></li>
          <li>{% icon "mail" %} <a href="mailto:{{ site.email }}">{{ site.email }}</a></li>
          <li>{% icon "pin" %} Serving {{ site.serviceArea }}</li>
          <li>{% icon "clock" %} {{ site.hours }}</li>
        </ul>
      </div>
    </div>
    <div class="container footer__base">
      <p>{{ site.footerBadges }}</p>
      <p>© <span data-year>2026</span> {{ site.legalName }}. Registered in {{ site.registeredIn }}, company no. {{ site.companyNumber }}.</p>
      <p><a href="/assets/docs/GMA-Modern-Slavery-Policy.pdf">Modern Slavery & Human Trafficking Policy & Annual Transparency Statement</a> · <a href="/privacy/">Privacy policy</a></p>
    </div>
  </footer>
  <script src="/assets/js/site.js" defer></script>
</body>
</html>
